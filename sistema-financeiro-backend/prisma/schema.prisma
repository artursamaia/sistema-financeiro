// prisma/schema.prisma
// ORM Prisma 5 — mapeamento do banco MySQL para o NestJS

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

/// ─── Usuário ───────────────────────────────────────────────
model users {
  id            Int      @id @default(autoincrement()) @db.UnsignedInt
  name          String   @db.VarChar(100)
  email         String   @unique(map: "uq_users_email") @db.VarChar(150)
  password_hash String   @db.VarChar(255)
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now()) @db.DateTime(0)
  updated_at    DateTime @default(now()) @updatedAt @db.DateTime(0)

  clients            clients[]
  expense_categories expense_categories[]
  expenses           expenses[]
  incomes            incomes[]
  loans              loans[]

  @@index([email], map: "idx_users_email")
}

/// ─── Categoria de Despesa ────────────────────────────────────
model expense_categories {
  id         Int      @id @default(autoincrement()) @db.UnsignedInt
  user_id    Int      @db.UnsignedInt
  name       String   @db.VarChar(80)
  color      String?  @default("#607D8B") @db.VarChar(7)
  icon       String?  @db.VarChar(50)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now()) @db.DateTime(0)
  updated_at DateTime @default(now()) @updatedAt @db.DateTime(0)

  users    users      @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_expense_categories_user")
  expenses expenses[]

  @@index([user_id], map: "idx_expense_categories_user")
}

/// ─── Receita ─────────────────────────────────────────────────
model incomes {
  id          Int      @id @default(autoincrement()) @db.UnsignedInt
  user_id     Int      @db.UnsignedInt
  description String   @db.VarChar(200)
  amount      Decimal  @db.Decimal(15, 2)
  received_at DateTime @db.Date
  is_recurring Boolean @default(false)
  notes       String?  @db.Text
  created_at  DateTime @default(now()) @db.DateTime(0)
  updated_at  DateTime @default(now()) @updatedAt @db.DateTime(0)

  users users @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_incomes_user")

  @@index([user_id, received_at], map: "idx_incomes_user_date")
  @@index([received_at], map: "idx_incomes_received_at")
}

/// ─── Despesa ─────────────────────────────────────────────────
model expenses {
  id          Int      @id @default(autoincrement()) @db.UnsignedInt
  user_id     Int      @db.UnsignedInt
  category_id Int?     @db.UnsignedInt
  description String   @db.VarChar(200)
  amount      Decimal  @db.Decimal(15, 2)
  due_date    DateTime @db.Date
  paid_at     DateTime? @db.Date
  is_fixed    Boolean  @default(false)
  is_paid     Boolean  @default(false)
  notes       String?  @db.Text
  created_at  DateTime @default(now()) @db.DateTime(0)
  updated_at  DateTime @default(now()) @updatedAt @db.DateTime(0)

  users              users               @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_expenses_user")
  expense_categories expense_categories? @relation(fields: [category_id], references: [id], onDelete: SetNull, map: "fk_expenses_category")

  @@index([user_id, due_date], map: "idx_expenses_user_date")
  @@index([due_date], map: "idx_expenses_due_date")
  @@index([category_id], map: "idx_expenses_category")
  @@index([is_paid], map: "idx_expenses_is_paid")
}

/// ─── Cliente ─────────────────────────────────────────────────
model clients {
  id         Int            @id @default(autoincrement()) @db.UnsignedInt
  user_id    Int            @db.UnsignedInt
  name       String         @db.VarChar(100)
  cpf        String?        @db.VarChar(14)
  phone      String?        @db.VarChar(20)
  email      String?        @db.VarChar(150)
  address    String?        @db.VarChar(300)
  city       String?        @db.VarChar(100)
  state      String?        @db.Char(2)
  status     clients_status @default(active)
  notes      String?        @db.Text
  created_at DateTime       @default(now()) @db.DateTime(0)
  updated_at DateTime       @default(now()) @updatedAt @db.DateTime(0)

  users users  @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_clients_user")
  loans loans[]

  @@unique([user_id, cpf], map: "uq_clients_cpf_user")
  @@index([user_id], map: "idx_clients_user")
  @@index([status], map: "idx_clients_status")
  @@index([name], map: "idx_clients_name")
}

/// ─── Empréstimo ───────────────────────────────────────────────
model loans {
  id                Int          @id @default(autoincrement()) @db.UnsignedInt
  user_id           Int          @db.UnsignedInt
  client_id         Int          @db.UnsignedInt
  principal_amount  Decimal      @db.Decimal(15, 2)
  interest_rate     Decimal      @default(0.0000) @db.Decimal(8, 4)
  total_amount      Decimal      @db.Decimal(15, 2)
  installments_count Int         @db.SmallInt
  start_date        DateTime     @db.Date
  first_due_date    DateTime     @db.Date
  status            loans_status @default(active)
  notes             String?      @db.Text
  created_at        DateTime     @default(now()) @db.DateTime(0)
  updated_at        DateTime     @default(now()) @updatedAt @db.DateTime(0)

  users        users          @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_loans_user")
  clients      clients        @relation(fields: [client_id], references: [id], onDelete: Restrict, map: "fk_loans_client")
  installments installments[]

  @@index([user_id], map: "idx_loans_user")
  @@index([client_id], map: "idx_loans_client")
  @@index([status], map: "idx_loans_status")
  @@index([start_date], map: "idx_loans_start_date")
}

/// ─── Parcela ─────────────────────────────────────────────────
model installments {
  id                 Int                 @id @default(autoincrement()) @db.UnsignedInt
  loan_id            Int                 @db.UnsignedInt
  installment_number Int                 @db.SmallInt
  due_date           DateTime            @db.Date
  amount             Decimal             @db.Decimal(15, 2)
  paid_amount        Decimal             @default(0.00) @db.Decimal(15, 2)
  status             installments_status @default(pending)
  paid_at            DateTime?           @db.Date
  created_at         DateTime            @default(now()) @db.DateTime(0)
  updated_at         DateTime            @default(now()) @updatedAt @db.DateTime(0)

  loans    loans      @relation(fields: [loan_id], references: [id], onDelete: Cascade, map: "fk_installments_loan")
  payments payments[]

  @@unique([loan_id, installment_number], map: "uq_installment_loan_number")
  @@index([loan_id], map: "idx_installments_loan")
  @@index([due_date], map: "idx_installments_due_date")
  @@index([status], map: "idx_installments_status")
  @@index([status, due_date], map: "idx_installments_status_due")
}

/// ─── Pagamento ───────────────────────────────────────────────
model payments {
  id             Int                     @id @default(autoincrement()) @db.UnsignedInt
  installment_id Int                     @db.UnsignedInt
  amount_paid    Decimal                 @db.Decimal(15, 2)
  paid_at        DateTime                @default(now()) @db.DateTime(0)
  payment_method payments_payment_method @default(cash)
  notes          String?                 @db.Text
  created_at     DateTime                @default(now()) @db.DateTime(0)

  installments installments @relation(fields: [installment_id], references: [id], onDelete: Restrict, map: "fk_payments_installment")

  @@index([installment_id], map: "idx_payments_installment")
  @@index([paid_at], map: "idx_payments_paid_at")
}

// ─── Enums ───────────────────────────────────────────────────

enum clients_status {
  active
  inactive
  defaulter
}

enum loans_status {
  active
  paid
  defaulted
  cancelled
}

enum installments_status {
  pending
  partial
  paid
  overdue
}

enum payments_payment_method {
  cash
  pix
  bank_transfer
  other
}
